# TLS-enabled nginx config — swapped in by scripts/setup_tls.sh once a real
# cert has been issued for DOMAIN (see DEPLOYMENT.md's "New customer
# checklist"). Not used directly: setup_tls.sh substitutes DOMAIN via sed
# before copying this over nginx/app.conf and reloading nginx.

client_max_body_size 20M;

upstream app {
    server web:8000;
}

# Plain HTTP: only the ACME challenge (renewals still happen over port 80)
# and a redirect to HTTPS for everything else.
server {
    listen 80;
    server_name DOMAIN;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name DOMAIN;

    ssl_certificate     /etc/letsencrypt/live/DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/DOMAIN/privkey.pem;

    # Served directly by nginx, bypassing the Python process entirely — real
    # production practice, not just a proxy passthrough.
    location /static/ {
        alias /app/staticfiles/;
        expires 30d;
        access_log off;
    }

    # No /media/ alias here, deliberately: manufacturing/urls.py never routes
    # anything under MEDIA_URL directly — every uploaded file (Document
    # Control, P2-F) is only ever served through the authenticated
    # /documents/<id>/download/ view (manufacturing.views.document_download),
    # which reads from MEDIA_ROOT itself after checking auth. Aliasing
    # /media/ here would bypass that check entirely and make every uploaded
    # file publicly downloadable with no authentication.

    location / {
        proxy_pass http://app;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Django's SECURE_PROXY_SSL_HEADER trusts this header once
        # DJANGO_HTTPS_ENABLED=True — safe because nginx is the only service
        # with a published port, so a client can never reach gunicorn
        # directly to spoof it themselves.
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
