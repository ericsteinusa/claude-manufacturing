#, python-format
msgid ""
"\n"
"        Composite score = 40%% on-time delivery + 35%% quantity fill rate + "
"25%% quality\n"
"        (100 − reject rate), renormalised over whichever of the three a "
"supplier has\n"
"        data for. On-time delivery only counts fully-received POs with both "
"an expected\n"
"        and an actual receipt date; fill rate covers POs that have been "
"sent.\n"
"        "
msgstr ""
"\n"
"        Gesamtpunktzahl = 40%% pünktliche Lieferung + 35%% "
"Mengenerfüllungsrate + 25%% Qualität\n"
"        (100 − Ablehnungsrate), renormiert auf die der drei Kennzahlen, für "
"die der Lieferant\n"
"        Daten hat. Pünktliche Lieferung zählt nur vollständig erhaltene "
"Bestellungen mit einem erwarteten\n"
"        und einem tatsächlichen Eingangsdatum; die Erfüllungsrate umfasst "
"versendete Bestellungen.\n"
"        "

