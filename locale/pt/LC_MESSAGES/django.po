#, python-format
msgid ""
"\n"
"        Composite score = 40%% on-time delivery + 35%% quantity fill rate + "
"25%% quality\n"
"        (100 − reject rate), renormalised over whichever of the three a "
"supplier has\n"
"        data for. On-time delivery only counts fully-received POs with both "
"an expected\n"
"        and an actual receipt date; fill rate covers POs that have been "
"sent.\n"
"        "
msgstr ""
"\n"
"        Pontuação composta = 40%% entrega no prazo + 35%% taxa de "
"atendimento de quantidade + 25%% qualidade\n"
"        (100 − taxa de rejeição), renormalizada sobre qual dos três o "
"fornecedor\n"
"        possui dados. A entrega no prazo conta apenas pedidos totalmente "
"recebidos com uma data de recebimento\n"
"        esperada e real; a taxa de atendimento cobre pedidos que foram "
"enviados.\n"
"        "

