#: manufacturing/templates/wms_putaway_rule_list.html:14
msgid ""
"Match a product's category or ABC class to a target zone. Rules are\n"
"    evaluated by priority (highest first); the first match wins. Products\n"
"    matching no active rule fall back to the unassigned bin at receipt time."
msgstr ""
"Asocia la categoría o clase ABC de un producto a una zona destino. Las "
"reglas se\n"
"    evalúan por prioridad (la más alta primero); gana la primera "
"coincidencia. Los productos\n"
"    que no coinciden con ninguna regla activa vuelven a la ubicación sin "
"asignar al momento de la recepción."

#: manufacturing/templates/wms_putaway_rule_list.html:29
msgid "e.g. 'raw material' or 'A'"
msgstr "p. ej. 'materia prima' o 'A'"

