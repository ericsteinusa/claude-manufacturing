#, python-format
msgid ""
"\n"
"        Composite score = 40%% on-time delivery + 35%% quantity fill rate + "
"25%% quality\n"
"        (100 − reject rate), renormalised over whichever of the three a "
"supplier has\n"
"        data for. On-time delivery only counts fully-received POs with both "
"an expected\n"
"        and an actual receipt date; fill rate covers POs that have been "
"sent.\n"
"        "
msgstr ""
"\n"
"        Puntuación compuesta = 40%% entrega a tiempo + 35%% tasa de "
"cumplimiento de cantidad + 25%% calidad\n"
"        (100 − tasa de rechazo), renormalizada sobre cualquiera de los tres "
"para los que el proveedor\n"
"        tenga datos. La entrega a tiempo solo cuenta las OC totalmente "
"recibidas con una fecha de recepción\n"
"        esperada y real; la tasa de cumplimiento cubre las OC que han sido "
"enviadas.\n"
"        "

