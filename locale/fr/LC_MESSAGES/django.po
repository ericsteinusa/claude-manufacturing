#: manufacturing/templates/wms_putaway_rule_list.html:14
msgid ""
"Match a product's category or ABC class to a target zone. Rules are\n"
"    evaluated by priority (highest first); the first match wins. Products\n"
"    matching no active rule fall back to the unassigned bin at receipt time."
msgstr ""
"Associe la catégorie ou la classe ABC d'un produit à une zone cible. Les "
"règles sont\n"
"    évaluées par priorité (la plus élevée d'abord) ; la première "
"correspondance l'emporte. Les produits\n"
"    ne correspondant à aucune règle active retombent dans l'emplacement non "
"assigné à la réception."

#: manufacturing/templates/wms_putaway_rule_list.html:29
msgid "e.g. 'raw material' or 'A'"
msgstr "par ex. 'matière première' ou 'A'"

#: manufacturing/templates/wms_putaway_rule_list.html:36
