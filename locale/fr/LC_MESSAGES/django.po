#, python-format
msgid ""
"\n"
"        Composite score = 40%% on-time delivery + 35%% quantity fill rate + "
"25%% quality\n"
"        (100 − reject rate), renormalised over whichever of the three a "
"supplier has\n"
"        data for. On-time delivery only counts fully-received POs with both "
"an expected\n"
"        and an actual receipt date; fill rate covers POs that have been "
"sent.\n"
"        "
msgstr ""
"\n"
"        Score composite = 40%% livraison à temps + 35%% taux de complétude "
"quantité + 25%% qualité\n"
"        (100 − taux de rejet), renormalisé sur celui des trois pour lequel "
"le fournisseur\n"
"        dispose de données. La livraison à temps ne compte que les commandes "
"entièrement reçues avec une date\n"
"        de réception prévue et réelle ; le taux de complétude couvre les "
"commandes envoyées.\n"
"        "

