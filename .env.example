DB_HOST=localhost
DB_NAME=company_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_PORT=5432

# Logging (optional)
LOG_LEVEL=INFO
# LOG_FILE=/var/log/manufacturing.log
# DJANGO_LOG_LEVEL=INFO

# Django deployment settings — leave unset for local dev (safe defaults apply).
# For a real deployment, set all of these via your platform's secrets manager,
# not a .env file on disk:
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<a real, unique secret — generate with get_random_secret_key()>
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# DJANGO_HTTPS_ENABLED=True   # only once nginx actually has a TLS cert — see DEPLOYMENT.md
