# Python
__pycache__/
*.py[cod]
*.pyo

# coverage.py
.coverage
htmlcov/

# Virtual environment
virt/
env/
.env
.env.local
.env/
venv/

# Per-deployment local customizations (see DEPLOYMENT.md) — not shared
# across deployments, same as .env above.
docker-compose.override.yml
nginx/selfsigned/
nginx/app-selfsigned.conf

# Databases (the app uses PostgreSQL; no SQLite file should be committed)
*.sqlite3

# Uploaded document files (Document Control module, P2-F)
/media/

# Qt
*.qmlc
*.jsc

# Claude Code — ignore session/settings data, but commit project skills
.claude/*
!.claude/skills
manufacturing/.claude/

# Local launchers and one-off scripts
launch_app.bat
run.py
run_login_test.bat
run_login_test.py
verify_production.py

# Captured output logs
*.txt

# Qt generated files (root and all department subdirectories)
manufacturing/**/*_rc.py
manufacturing/*_rc.py
manufacturing/**/*.ui
manufacturing/*.ui

# SQLite leftovers (app uses PostgreSQL)
*.db
manufacturing/create_missing_tables.sql

# Editor
manufacturing/.vscode/

# OS
.DS_Store
Thumbs.db

# Windows deployment runtime artifacts (scripts/windows/) — PID file and
# server/autopull logs generated on whichever machine runs them, not shared.
manufacture-server.pid
manufacture-server.log
manufacture-server.log.err
manufacture-autopull.log
